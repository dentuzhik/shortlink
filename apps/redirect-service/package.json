{
  "name": "@url-shortener/redirect-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @url-shortener/db build && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "pnpm --filter @url-shortener/redirect-service... build && vitest run test/integration",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@url-shortener/db": "workspace:*",
    "fastify": "5.12.8",
    "graphql": "17.1.0",
    "graphql-yoga": "6.0.1",
    "ioredis": "6.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.1",
    "vitest": "5.1.0"
  }
}
