{
  "name": "@url-shortener/redirect-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @url-shortener/db build && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@url-shortener/db": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "vitest": "5.1.0"
  }
}
