    {
      "id": 9,
      "title": "Fan speed and hottest temperature over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clusterctrl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      },
      "description": "Actual PWM command, not measured RPM. Temperatures use the hottest fresh controller/node reading. This panel always covers the whole cluster. Gaps indicate unavailable fan telemetry.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hottest temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "min",
                "value": 25
              },
              {
                "id": "max",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Smoothed temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "min",
                "value": 25
              },
              {
                "id": "max",
                "value": 85
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "clusterhat_fan_duty_percent",
          "legendFormat": "Fan duty %",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "expr": "clusterhat_fan_hottest_temperature_celsius",
          "legendFormat": "Hottest temperature",
          "refId": "B",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "expr": "clusterhat_fan_filtered_temperature_celsius",
          "legendFormat": "Smoothed temperature",
          "refId": "C",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 10,
      "title": "Configured temperature \u2192 fan curve",
      "type": "xychart",
      "datasource": {
        "type": "prometheus",
        "uid": "clusterctrl-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 9
      },
      "description": "Live policy breakpoints from /etc/clusterhat-fan.json. Off-temperature hysteresis, startup spin-up, smoothing and ramp-down affect the actual history on the left.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable",
          "min": 0,
          "max": 100,
          "custom": {
            "show": "points+lines",
            "lineWidth": 2,
            "pointSize": {
              "fixed": 7
            },
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Temperature"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              },
              {
                "id": "min",
                "value": 35
              },
              {
                "id": "max",
                "value": 80
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "clusterhat_fan_curve_duty_percent",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "mapping": "manual",
        "series": [
          {
            "name": {
              "fixed": "Fan policy"
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            },
            "x": {
              "matcher": {
                "id": "byName",
                "options": "Temperature"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "Fan duty"
              }
            }
          }
        ],
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "showLegend": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["temperature_c", "clusterhat_fan_curve_duty_percent"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "temperature_c": "Temperature",
              "clusterhat_fan_curve_duty_percent": "Fan duty"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Temperature",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Temperature",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "CPU and memory \u00b7 selected machines",
      "type": "row",
