{
  "uid": "clusterctrl-hardware",
  "title": "ClusterCTRL \u00b7 Hardware",
  "description": "Controller and P1\u2013P4 hardware health, SD-card I/O, connectivity, temperature and fan control. Missing measurements remain gaps; exporter health is explicit.",
  "tags": ["clusterctrl", "hardware", "raspberry-pi", "local"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Machines",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clusterctrl-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"nodes\"}, node)",
          "refId": "node-variable"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "interface",
        "label": "Interfaces",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clusterctrl-prometheus"
        },
        "query": {
          "query": "label_values(node_network_receive_bytes_total{job=\"nodes\",node=~\"$node\",device!=\"lo\"}, device)",
          "refId": "interface-variable"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Availability \u00b7 controller and four Pi Zeros",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Controller",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "clusterctrl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "A successful metrics scrape means online. A powered node can still be unreachable; see HAT power below.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "Unavailable",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"nodes\",node=\"cbridge\"}",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "colorMode": "background_solid",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["last"],
          "values": false
        },
        "textMode": "value"
      }
    },
