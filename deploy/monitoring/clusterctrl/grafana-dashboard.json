    {
      "id": 12,
      "title": "CPU busy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clusterctrl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(100 * (1 - avg by(node)(rate(node_cpu_seconds_total{job=\"nodes\",node=~\"$node\",mode=\"idle\"}[$__rate_interval])))) and on(node) max by(node)(up{job=\"nodes\",node=~\"$node\"} == 1)",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 13,
      "title": "RAM used \u00b7 excludes reclaimable cache",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clusterctrl-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(100 * (1 - max by(node)(node_memory_MemAvailable_bytes{job=\"nodes\",node=~\"$node\"}) / max by(node)(node_memory_MemTotal_bytes{job=\"nodes\",node=~\"$node\"}))) and on(node) max by(node)(up{job=\"nodes\",node=~\"$node\"} == 1)",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 14,
      "title": "Load average / CPU cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clusterctrl-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "description": "1.0 means one runnable task per CPU core; sustained values above 1 indicate contention.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_load1{job=\"nodes\",node=~\"$node\"} / on(node) group_left count by(node)(node_cpu_seconds_total{job=\"nodes\",node=~\"$node\",mode=\"idle\"})",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 15,
      "title": "RAM and swap used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "clusterctrl-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "Unavailable",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{job=\"nodes\",node=~\"$node\"} - node_memory_MemAvailable_bytes{job=\"nodes\",node=~\"$node\"}",
          "legendFormat": "{{node}} RAM",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
