    {
      "id": 16,
      "title": "Redirect p99 by pod · server",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Each pod gets its own histogram-derived p99, preserving both pod and le while aggregating buckets. No traffic means no percentile. This is Fastify time, not client latency; 100ms is a reference line.",
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.99, sum by (pod, le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",pod=~\"$pod\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "{{pod}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
