{
  "uid": "shortlink-overview",
  "title": "Shortlink overview",
  "description": "Local HTTP traffic and Postgres pool metrics from the redirect service.",
  "tags": ["shortlink", "local"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Fastify scrape",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Prometheus target health. One means the metrics endpoint can be scraped.",
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"redirect-service\"})",
          "legendFormat": "Scrape",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Redirect requests / s",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "A 30-second rate of completed responses.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(shortlink_http_requests_total{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])) or vector(0)",
          "legendFormat": "Redirects",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx total \u00b7 current pods",
      "type": "stat",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Cumulative errors in the currently running Fastify processes; resets on pod restart. This also shows the first event of a new status series, which rate() cannot infer before a baseline sample exists.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shortlink_http_requests_total{job=\"redirect-service\",status_code=~\"5..\"}) or vector(0)",
          "legendFormat": "5xx total",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Waiting pool checkouts",
      "type": "stat",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Current pg queue snapshots, summed across pods.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shortlink_db_pool_waiting_requests{job=\"redirect-service\"})",
          "legendFormat": "Waiting",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Redirect p99 \u00b7 server",
      "type": "stat",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Histogram estimate of Fastify duration. This excludes Gateway/client overhead and does not prove the client latency target.",
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Traffic by route",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Completed-response rates. Short codes are grouped into /:code. Rate windows smooth the k6 stages.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(shortlink_http_requests_total{job=\"redirect-service\"}[30s]))",
          "legendFormat": "{{route}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Redirect latency \u00b7 server",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Estimated from cumulative histogram buckets over 30 seconds. The 100ms line is a reference; our agreed performance target is measured by the client.",
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.5, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Responses by HTTP status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "The demo deliberately requests missing codes on 5% of visits. Those 404s are expected test traffic.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(shortlink_http_requests_total{job=\"redirect-service\"}[30s]))",
          "legendFormat": "HTTP {{status_code}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Pool clients by state",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "in_use = totalCount - idleCount, including clients still connecting. It is not an active-SQL-query count.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (shortlink_db_pool_connections{job=\"redirect-service\"})",
          "legendFormat": "{{state}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Pool queue",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 12,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Sampled every five seconds. Short-lived queue spikes may occur between scrapes.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shortlink_db_pool_waiting_requests{job=\"redirect-service\"})",
          "legendFormat": "Waiting checkouts",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Reading this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Run **`pnpm load:demo`** to generate a 100 \u2192 500 \u2192 1,000 \u2192 100 redirects/s profile, plus one GraphQL link creation/s. Five percent of visits deliberately request missing codes.\n\nPrometheus scrapes individual pods every **5 seconds**. Rates and percentile estimates use **30-second windows**, so charts smooth and lag the load stages. Durations here are **Fastify server time**, not browser or k6 time. Pool gauges are snapshots. HTTP `200` may still contain GraphQL errors.\n\nThe dashboard and datasource are provisioned from repository files. Prometheus retains local history for up to **24 hours / 256 MB**."
      }
    }
  ]
}
