{
  "uid": "shortlink-overview",
  "title": "Shortlink overview",
  "description": "Combined Fastify metrics and per-pod diagnostics. Scrape health is separate from application readiness.",
  "tags": ["shortlink", "local"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 20,
      "title": "Overview · all Fastify pods",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Scrape targets up",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Current count of successful Fastify scrapes across all discovered targets. This is not Kubernetes readiness, the desired replica count, or an end-to-end availability measurement. A removed target disappears from discovery.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"redirect-service\"}) or vector(0)",
          "legendFormat": "Targets up",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "title": "Failed scrapes",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Current discovered targets whose latest scrape failed. Targets removed from discovery are absent, so zero does not prove the desired number of replicas exists.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"redirect-service\"} == 0) or vector(0)",
          "legendFormat": "Failed",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Redirects / s",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "A 30-second rate of completed responses.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(shortlink_http_requests_total{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])) or vector(0)",
          "legendFormat": "Redirects",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "5xx · current pods",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Cumulative errors in the currently running Fastify processes; resets on pod restart. This also shows the first event of a new status series, which rate() cannot infer before a baseline sample exists.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shortlink_http_requests_total{job=\"redirect-service\",status_code=~\"5..\"}) or vector(0)",
          "legendFormat": "5xx total",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Waiting checkouts",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Current pg queue snapshots, summed across pods.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(shortlink_db_pool_waiting_requests{job=\"redirect-service\"})",
          "legendFormat": "Waiting",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Redirect p99 · server",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Histogram estimate of Fastify duration. This excludes Gateway/client overhead and does not prove the client latency target. Current 30-second window only; no recent requests means no percentile.",
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No recent traffic"
                }
              }
            }
          ],
          "noValue": "No recent traffic"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Traffic by route",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Completed-response rates. Short codes are grouped into /:code. Rate windows smooth the k6 stages.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(shortlink_http_requests_total{job=\"redirect-service\"}[30s]))",
          "legendFormat": "{{route}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Redirect latency · server",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Estimated from cumulative histogram buckets over 30 seconds. The 100ms line is a reference; our agreed performance target is measured by the client.",
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.5, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(shortlink_http_request_duration_seconds_bucket{job=\"redirect-service\",route=\"/:code\",method=\"GET\"}[30s])))",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
