    {
      "id": 21,
      "title": "Per-pod diagnostics · filtered by Pods (details)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "title": "Current scrape health by pod",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Instant query: only currently discovered selected targets. UP means the metrics listener responded, not that /readyz or redirects work. Replaced pods appear in history, not here.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"redirect-service\",pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "wideLayout": false,
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      }
    },
    {
      "id": 14,
      "title": "Scrape history by pod",
      "type": "state-timeline",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "One row per selected pod observed in the time range. Replacements create new pod names and rows. Gaps mean no sample; disappearing from discovery is not a recorded DOWN value. Scrape health is not application readiness.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"redirect-service\",pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 15,
      "title": "Redirect requests / s by pod",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shortlink-prometheus"
      },
      "description": "Completed redirects and other responses on GET /:code, grouped by selected pod. Thirty-second windows smooth traffic. A newly started pod needs counter samples before rate() can estimate traffic.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(shortlink_http_requests_total{job=\"redirect-service\",pod=~\"$pod\",route=\"/:code\",method=\"GET\"}[30s]))",
          "legendFormat": "{{pod}}",
          "editorMode": "code",
          "range": true,
