{
  "name": "url-shortener",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @url-shortener/redirect-service dev",
    "dev:web": "pnpm --filter @url-shortener/web dev",
    "stack:up": "sh scripts/stack-up.sh",
    "stack:down": "docker compose down",
    "k8s:up": "sh scripts/k8s-up.sh",
    "k8s:gateway": "sh scripts/k8s-gateway.sh",
    "k8s:gateway:down": "docker compose -f deploy/kind/compose.yaml down",
    "monitoring:up": "sh scripts/monitoring-up.sh",
    "load:demo": "sh scripts/load-demo.sh",
    "k8s:forward": "sh scripts/k8s-forward.sh",
    "bench:redirect": "sh scripts/bench-redirect.sh",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @url-shortener/redirect-service start",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test",
    "test:e2e:containers": "node scripts/test-e2e-containers.mjs",
    "test:web-rollout": "node scripts/test-web-rollout.mjs",
    "test:integration": "sh scripts/test-integration.sh",
    "test:db-restore": "pnpm --filter @url-shortener/redirect-service... build && node scripts/rehearse-db-restore.mjs",
    "test:db-switchover": "node scripts/test-db-switchover.mjs",
    "test:db-connectivity": "node scripts/test-db-connectivity.mjs",
    "test:replication": "node scripts/rehearse-replication.mjs",
    "test:rolling-restart": "node scripts/test-rolling-restart.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:lab:up": "sh scripts/db-lab-up.sh",
    "db:lab:check": "node scripts/db-lab-check.mjs",
    "db:lab:connect": "node scripts/db-lab-connect.mjs",
    "db:replication:prepare": "node scripts/prepare-replication.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "pnpm --filter @url-shortener/db generate",
    "db:migrate": "pnpm --filter @url-shortener/db migrate",
    "db:studio": "pnpm --filter @url-shortener/db exec drizzle-kit studio --host=127.0.0.1",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "image:redirect": "node scripts/release-redirect.mjs build",
    "k8s:deploy": "node scripts/release-redirect.mjs deploy",
    "k8s:deploy:local": "node scripts/release-redirect.mjs deploy-local",
    "k8s:rollback": "node scripts/release-redirect.mjs rollback",
    "k8s:version": "node scripts/release-redirect.mjs status",
    "k8s:deploy:web": "node scripts/release-redirect.mjs web deploy",
    "k8s:rollback:web": "node scripts/release-redirect.mjs web rollback",
    "k8s:version:web": "node scripts/release-redirect.mjs web status",
    "test:release": "node --test scripts/test/*.test.mjs",
    "db:source:prepare": "node scripts/source-maintenance.mjs prepare",
    "test:source-maintenance": "node scripts/source-maintenance.mjs rehearse",
    "db:source:maintain": "node scripts/source-maintenance.mjs apply",
    "db:source:check": "node scripts/source-maintenance.mjs check",
    "db:source:resume": "node scripts/source-maintenance.mjs resume",
    "db:replication:start": "node scripts/live-replication.mjs start",
    "db:replication:status": "node scripts/live-replication.mjs status",
    "test:replication:live": "node scripts/live-replication.mjs verify",
    "test:replication:watch": "node scripts/test-replication-watch.mjs",
    "maintenance:status": "node scripts/runtime-maintenance.mjs status",
    "maintenance:begin": "node scripts/runtime-maintenance.mjs begin",
    "maintenance:end": "node scripts/runtime-maintenance.mjs end",
    "test:maintenance:k8s": "pnpm --filter @url-shortener/redirect-service... build && node scripts/test-runtime-maintenance.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
