{
  "name": "url-shortener",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @url-shortener/redirect-service dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @url-shortener/redirect-service start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:generate": "pnpm --filter @url-shortener/db generate",
    "db:migrate": "pnpm --filter @url-shortener/db migrate",
    "db:studio": "pnpm --filter @url-shortener/db exec drizzle-kit studio --host=127.0.0.1",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
